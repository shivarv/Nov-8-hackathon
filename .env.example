# Copy to .env to override docker-compose defaults.
POSTGRES_USER=grocer
POSTGRES_PASSWORD=grocer
POSTGRES_DB=grocer
# Number of synthetic historical orders generated on first boot (empty DB only).
SEED_ORDERS=3000

# Anthropic (Claude) API key, used for product price estimation
ANTHROPIC_API_KEY=
# Unbox AI BehaviorGPT key, from https://portal.unboxai.com
UNBOXAI_API_KEY=
# Catalog id printed by prototype/upload_catalog.py (catalogs belong to one API key)
UNBOXAI_CATALOG_ID=

# Data source when the DB is empty: auto (Instacart if archive/ exists), instacart, synthetic
DATA_SOURCE=auto
# Real Instacart orders loaded as history for the bought-together model
INSTACART_ORDERS=20000
