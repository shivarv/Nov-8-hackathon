# Copy to .env to override docker-compose defaults.
POSTGRES_USER=grocer
POSTGRES_PASSWORD=grocer
POSTGRES_DB=grocer
# Order history loaded on first boot (empty DB only; `make reset` to re-seed).
# instacart = real products + orders from backend/data/instacart, synthetic = small made-up catalog
SEED_SOURCE=instacart
# Orders to seed; 0 = all (~62k Instacart orders, or 3000 synthetic)
SEED_ORDERS=0

# Anthropic (Claude) API key, used for product price estimation
ANTHROPIC_API_KEY=
# Unbox AI BehaviorGPT key, from https://portal.unboxai.com
UNBOX_API_KEY=
